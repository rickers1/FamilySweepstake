@using FamilySweepstake.Components
@using FamilySweepstake.Models
@using FamilySweepstake.Services
@using FamilySweepstake.ViewModels

@page "/rankings/{TournamentCode}"

@inject ITournamentService TournamentSvc
@inject FamilyMemberCache FamilyMemberCache
@inject TournamentCache TournamentCache

<MudPaper Class="pa-4">

    <MudText Typo="Typo.h5" Class="mb-4">
        Family Pool Rankings
    </MudText>

    <MudTable Dense Hover="true" Items="Rankings">

        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Total Points</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTr>
                <MudTd>
                    <MudExpansionPanels Elevation="0">
                        <MudExpansionPanel Text="@context.Name">
                            @foreach (var team in context.Teams)
                            {
                                <PoolCard PoolName="@poolGroup.Pool" Teams="@poolGroup.Teams" Standings="@standings" Ownerships="@ownerships" />
                            }
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudTd>

                <MudTd>
                    @context.TotalPoints
                </MudTd>
            </MudTr>
        </RowTemplate>

    </MudTable>

</MudPaper>

@code {
    public class FamilyPoolEntry
    {
        public string Name { get; set; } = "";
        public int TotalPoints { get; set; }
        public List<Team> Teams { get; set; } = new();
    }

    // Replace this with your actual data source
    public List<FamilyPoolEntry> Rankings { get; set; } = new();

    protected override void OnInitialized()
    {
        // Example: load your real data here
        Rankings = LoadFamilyPoolData()
            .OrderByDescending(r => r.TotalPoints)
            .ToList();
    }

    private List<FamilyPoolEntry> LoadFamilyPoolData()
    {
        // Stub — replace with your actual logic
        return new List<FamilyPoolEntry>
        {
            new () {
                Name = "Andy",
                TotalPoints = 36,
                Teams = new() { /* your team objects */ }
            },
            new () {
                Name = "Di",
                TotalPoints = 29,
                Teams = new() { /* your team objects */ }
            }
        };
    }
}
