@* // Ignore Spelling: leaderboard *@

@page "/leaderboard/{TournamentCode}"

@using FamilySweepstake.Components
@using FamilySweepstake.Services
@using FamilySweepstake.ViewModels
@using static FamilySweepstake.Models.Constants

@inject CacheService CacheSvc

<PageHeader ColouredIcon="@LEADERBOARD_COLOURED_ICON" Text="Family Leaderboard" />

@if (_isLoading)
{
    <LoadingSpinner WhatsIsLoading="leaderboard" />
}
else
{
    @foreach (var owner in leaderboard)
    {
        <MudExpansionPanel>
            <TitleContent>
                <MudGrid Spacing="1">
                    <MudItem xs="3" sm="2" md="1" Class="@owner.OwnerColoursCss">
                        <MudAvatar Size="Size.Large" Color="Color.Transparent">
                            @GetRankingIcon(owner.Ranking)
                        </MudAvatar>
                    </MudItem>

                    <MudItem xs="6" sm="8" md="3">
                        <OwnerCard TeamOwner="owner.Owner" ShowOwnerName />
                    </MudItem>

                    <MudItem xs="3" sm="2" md="1">
                        <ScoreChip TeamCode="@owner.Owner.Name" Score="owner.TotalPoints" />
                    </MudItem>
                </MudGrid>
            </TitleContent>

            <ChildContent>
                <MudExpansionPanels>
                    @if (owner.Teams is not null)
                    {
                        foreach (var (team, index) in owner.Teams.Select((value, i) => (value, i)))
                        {
                            var isFirst = index == 0;
                            var poolTeam = team!.Standing;

                            <MudExpansionPanel>
                                <TitleContent>
                                    <PoolTeamScoreCard Teams="@([poolTeam])" ShowWDL ShowOwner="false" ShowColHeaders="isFirst" />
                                </TitleContent>

                                <ChildContent>
                                    <MudStack Class="pt-2">
                                        @foreach (var fixture in team!.Fixtures)
                                        {
                                            <FixtureRow Fixture="fixture" ShowMatchDateAndTime="true" />
                                        }
                                    </MudStack>
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    }
                </MudExpansionPanels>
            </ChildContent>
        </MudExpansionPanel>
    }
}

@code {
    [Parameter] public string TournamentCode { get; set; } = DEFAULT_CODE;

    private bool _isLoading = true;
    private IEnumerable<OwnerLeaderboardEntry> leaderboard = [];
    private List<string> _rankingIcons = [];

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _rankingIcons = [..RANKING_ICONS.Split(',')];

    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        //Select tournament (this reloads TeamsCache automatically if needed)
        await CacheSvc.SetTournamentAsync(TournamentCode);

        leaderboard = await BuildLeaderboard();

        _isLoading = false;
    }

    private async Task<IEnumerable<OwnerLeaderboardEntry>> BuildLeaderboard()
    {
        var standingsData = await CacheSvc.Service.GetPoolStandingsAsync(CacheSvc.Tournaments.CurrentTournamentId!);
        var standings = standingsData.ToDictionary(k => k.TeamCode, v => v, StringComparer.OrdinalIgnoreCase);

        var ownerships = CacheSvc.TeamOwners.AllForPools;
        var members = CacheSvc.FamilyMembers.All;

        var fixtures = await CacheSvc.Service.GetFixturesAsync(CacheSvc.Tournaments.CurrentTournamentCode!);

        var fixturesByTeam = fixtures
            .Where(f => !f.IsPlayoffs)
            .SelectMany(f => new[]
            {
                new { Code = f.HomeCode, Fixture = f },
                new { Code = f.AwayCode, Fixture = f }
            })
            .Where(x => !string.IsNullOrWhiteSpace(x.Code))
            .GroupBy(x => x.Code!)
            .ToDictionary(
                g => g.Key,
                g => g.Select(x => x.Fixture).ToList()
            );

        var ordered = ownerships.Values
            .Where(o => o.OwnerId is not null)
            .GroupBy(o => o.OwnerId!.Value)
            .Select(group =>
            {
                var owner = members[group.Key];

                var teams = group
                    .Select(o =>
                    {
                        if (!standings.TryGetValue(o.TeamCode!, out var standing))
                            return null;

                        fixturesByTeam.TryGetValue(o.TeamCode!, out var fx);

                        return new TeamLeaderboardEntry(o.TeamCode!, standing, standing.Points, fx ?? []);
                    })
                    .Where(t => t is not null)
                    .ToList();

                var total = teams.Sum(t => t!.PointsAwarded);

                return new { Owner = owner, Total = total, Teams = teams };
            })
            .OrderByDescending(e => e.Total);

        return ordered
            .Select((e, index) => new OwnerLeaderboardEntry(e.Owner, index + 1, e.Total, e.Teams))
            .ToList();
    }

    private string GetRankingIcon(int rank)
        => _rankingIcons[Math.Min(rank - 1, _rankingIcons.Count - 1)];
}
