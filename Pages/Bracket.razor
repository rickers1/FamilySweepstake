@* // Ignore Spelling: center centering mx *@

@page "/bracket/{TournamentCode}"

@using FamilySweepstake.Components
@using FamilySweepstake.Extensions
@using FamilySweepstake.Models
@using FamilySweepstake.Services
@using FamilySweepstake.ViewModels
@using static FamilySweepstake.Models.Constants

@inject CacheService CacheSvc

<PageHeader ColouredIcon="@BRACKET_COLOURED_ICON" Text="Playoff Bracket" />

@if (_isLoading)
{
    <LoadingSpinner WhatsIsLoading="brackets" />
}
else
{
    <MudButtonGroup Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
        @for (int i = 0; i < _groupedRounds.Count; i++)
        {
            var roundIdx = i; // Need `roundIdx` as `i` is maxed out after rendering
            <MudButton Size="Size.Small" OnClick="@(() => OnRoundSelected(roundIdx))" Disabled="@(roundIdx == _activeRound)" Class="mx-1">
                @_groupedRounds[roundIdx].Stage
            </MudButton>
        }
    </MudButtonGroup>

    <div class="bracket-container">
        @for (int i = 0; i < _groupedRounds.Count; i++)
        {
            var roundIdx = i;
            var round = _groupedRounds[i];

            if (roundIdx < _activeRound) continue;

            <div class="bracket-round @(round.IsMedalRound ? "medal-round" : "")">
                @if (round.IsMedalRound)
                {
                    // Medal Round: Center the Gold match and hang the Bronze match below it.
                    var goldMatch = round.Fixtures.FirstOrDefault(m => m.BracketSlotViewModel!.ParseSlot().SlotIndex == 1);
                    var bronzeMatch = round.Fixtures.FirstOrDefault(m => m.BracketSlotViewModel!.ParseSlot().SlotIndex == 2);    

                    <div class="bracket-match-wrapper gold-match">
                        <div style="position: relative; width: 100%;">

                            @if (goldMatch is not null)
                            {
                                <MudPaper Elevation="3" Class="pa-3" Style="width: 100%;" id="@GetFixtureId(goldMatch)">
                                    <div class="d-flex justify-center mb-2">
                                        <MudText Typo="Typo.caption"><b>🏆 CHAMPIONSHIP</b></MudText>
                                    </div>
                                    <MudDivider Class="mb-2" />
                                    <div class="d-flex justify-space-between">
                                        <BracketNode Fixture="goldMatch" MedalIcons="GoldMedalIcons" />
                                    </div>
                                </MudPaper>
                            }

                            @if (bronzeMatch is not null)
                            {
                                <!-- Position absolute takes the bronze match out of the flow so it doesn't affect centering -->
                                <div style="position: absolute; top: calc(100% + 24px); width: 100%;" id="@GetFixtureId(bronzeMatch)">
                                    <MudPaper Elevation="3" Class="pa-3" Style="width: 100%;">
                                        <div class="d-flex justify-center mb-2">
                                            <MudText Typo="Typo.caption"><b>🥉 3RD PLACE PLAYOFF</b></MudText>
                                        </div>
                                        <MudDivider Class="mb-2" />
                                        <div class="d-flex justify-space-between">
                                            <BracketNode Fixture="bronzeMatch" MedalIcons="BronzeMedalIcons" />
                                        </div>
                                    </MudPaper>
                                </div>
                            }

                        </div>
                    </div>
                }
                else
                {
                    // Standard Match Output
                    @foreach (var match in round.Fixtures)
                    {
                        <div class="bracket-match-wrapper" id="@GetFixtureId(match)">
                            <MudPaper Elevation="3" Class="pa-3" Style="width: 100%;">
                                <div class="d-flex justify-space-between">
                                    <BracketNode Fixture="match" />
                                </div>
                            </MudPaper>
                        </div>
                    }
                }
            </div>
        }
    </div>
}

<style>
    .bracket-container {
        display: flex;
        flex-direction: row;
        overflow-x: auto;
        padding: 24px;
        gap: 40px;
        align-items: stretch; /* Ensures all rounds share the exact same height */
    }

    .bracket-round {
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        flex: 0 0 auto; /* Prevents resizing inside the flex container */
        /* Mobile default (xs) */
        width: 85vw;
    }

        .bracket-round.medal-round {
            width: 95vw;
        }

    /* sm breakpoint (Tablet) - MudBlazor uses 600px */
    @@media (min-width: 600px) {
        .bracket-round {
            width: 47vw;
        }

            .bracket-round.medal-round {
                width: 55vw;
            }
    }

    /* md breakpoint (Small Desktop) - MudBlazor uses 960px */
    @@media (min-width: 960px) {
        .bracket-round {
            width: 30vw;
        }

            .bracket-round.medal-round {
                width: 38vw;
            }
    }

    /* lg breakpoint (Desktop) - MudBlazor uses 1280px */
    @@media (min-width: 1280px) {
        .bracket-round {
            width: 25vw;
        }

            .bracket-round.medal-round {
                width: 30vw;
            }
    }

    .bracket-match-wrapper {
        position: relative;
        flex: 1; /* Makes wrappers stretch to touch each other for continuous vertical lines */
        display: flex;
        align-items: center;
        padding: 8px 0;
    }

    /* Draw the connecting lines */
    /* This is a comment */
    .bracket-round:not(:last-child) .bracket-match-wrapper:nth-child(odd)::after {
        content: "";
        position: absolute;
        right: -20px;
        top: 50%;
        width: 20px;
        height: 50%;
        border-top: 2px solid var(--mud-palette-lines-default);
        border-right: 2px solid var(--mud-palette-lines-default);
        border-top-right-radius: 4px;
    }

    .bracket-round:not(:last-child) .bracket-match-wrapper:nth-child(even)::after {
        content: "";
        position: absolute;
        right: -20px;
        bottom: 50%;
        width: 20px;
        height: 50%;
        border-bottom: 2px solid var(--mud-palette-lines-default);
        border-right: 2px solid var(--mud-palette-lines-default);
        border-bottom-right-radius: 4px;
    }

    /* Connect the converging elbows to the next match */
    .bracket-round:not(:first-child) .bracket-match-wrapper::before {
        content: "";
        position: absolute;
        left: -20px;
        top: 50%;
        width: 20px;
        border-top: 2px solid var(--mud-palette-lines-default);
    }
</style>

@code {
    [Parameter] public string TournamentCode { get; set; } = DEFAULT_CODE;

    private bool _isLoading = true;
    private int _activeRound = 0;

    private List<FixtureModel> _fixtures = [];

    // Structures flat fixtures into an ordered hierarchy for rendering
    private List<BracketRoundViewModel> _groupedRounds = [];
    private List<BracketRoundViewModel> _visibleRounds = [];
    private List<string> _medalIcons = [];
    private List<string> GoldMedalIcons => [.. _medalIcons.Take(2)];
    private List<string> BronzeMedalIcons => [.. _medalIcons.Skip(2).Take(2)];

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _medalIcons = RANKING_ICONS.Split(',').ToList();
        while (_medalIcons.Count() < 4)
            _medalIcons.Add(CONFUSED_EMOJI);
    }

    /// <summary>
    /// Initialises the component parameters and loads the bracket data.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        await CacheSvc.SetTournamentAsync(TournamentCode);
        await BuildBracketAsync();
        _isLoading = false;
    }

    /// <summary>
    /// Builds the tournament bracket by fetching fixtures, advancing winners, and grouping rounds.
    /// </summary>
    private async Task BuildBracketAsync()
    {
        _fixtures = await CacheSvc.Service.GetBracketFixturesAsync(TournamentCode);

        BuildBracketDetail();

        _groupedRounds = [.. _fixtures
            .OrderBy(f => f.BracketSlotViewModel.ParseSlot().SlotIndex)
            .GroupBy(f => BuildRoundKey(f.BracketSlotViewModel!, f.Stage ?? DEFAULT_NAME))
            .Select(g => new BracketRoundViewModel(roundSize: g.Key.RoundSize, stage: g.Key.Stage, isMedalRound: g.Key.IsMedalRound, fixtures: [.. g]))
            .OrderByDescending(r => r.RoundSize)
            .ThenBy(r => r.Stage)];

        UpdateVisibleRounds();
    }

    private (int RoundSize, string Stage, bool IsMedalRound) BuildRoundKey(string bracketSlot, string stage)
    {
        var roundSize = bracketSlot.ParseSlot().RoundSize;
        var isMedalRound = roundSize == 2;
        return (RoundSize: roundSize, Stage: isMedalRound ? MEDAL_ROUND_STAGE_NAME : stage, IsMedalRound: isMedalRound);
    }

    /// <summary>
    /// Updates the currently active round and handles animation state changes.
    /// </summary>
    /// <param name="roundIdx">The index of the round to make active.</param>
    private void OnRoundSelected(int roundIdx)
    {
        _activeRound = roundIdx;
        UpdateVisibleRounds();
    }

    /// <summary>
    /// Updates the collection of visible rounds by skipping prior rounds.
    /// </summary>
    private void UpdateVisibleRounds()
        => _visibleRounds = _groupedRounds.Skip(_activeRound).ToList();

    /// <summary>
    /// Builds the internal fixture details by simulating the advancement of winners and losers.
    /// </summary>
    private void BuildBracketDetail()
    {
        var bySlot = _fixtures.ToDictionary(f => new BracketSlotViewModel(f.BracketSlotViewModel.ParseSlot()), f => f);

        foreach (var fixture in _fixtures)
        {
            var (roundSize, slot) = fixture.BracketSlotViewModel.ParseSlot();

            // We do not advance anyone OUT of the final round
            if (roundSize < 4) continue;

            // Odd slots (1, 3, 5...) go Home. Even slots (2, 4, 6...) go Away.
            bool isHome = slot % 2 != 0;

            if (roundSize == 4)
            {
                // Semifinals: Winners to Gold (Slot 1), Losers to Bronze (Slot 2)
                AdvanceFromRound(bySlot, fixture, 2, 1, isHome);
                AdvanceFromRound(bySlot, fixture, 2, 2, isHome, advanceTheWinner: false);
            }
            else
            {
                // Standard progression (e.g., 32 -> 16, 16 -> 8, 8 -> 4)
                AdvanceFromRound(bySlot, fixture,
                    toRoundSize: roundSize / 2,
                    toSlot: (slot + 1) / 2,
                    isHome);
            }
        }
    }

    /// <summary>
    /// Advances either the winner or loser of a given fixture to the designated slot in a future round.
    /// </summary>
    /// <param name="fixturesByRound">The dictionary of fixtures keyed by their bracket slot.</param>
    /// <param name="from">The originating fixture.</param>
    /// <param name="toRoundSize">The target round size.</param>
    /// <param name="toSlot">The target slot number.</param>
    /// <param name="isHome">Indicates if the advancing team should be placed in the home position.</param>
    /// <param name="advanceTheWinner">If true (or null), advances the winner. If false, advances the loser.</param>
    private void AdvanceFromRound(Dictionary<BracketSlotViewModel, FixtureModel> fixturesByRound, FixtureModel from, int toRoundSize, int toSlot, bool isHome, bool? advanceTheWinner = true)
    {
        var codeToAdvance = (advanceTheWinner is true)
            ? (from.HomeWin ? from.HomeCode : from.AwayCode)
            : (from.HomeWin ? from.AwayCode : from.HomeCode);

        if (!fixturesByRound.TryGetValue(new BracketSlotViewModel(toRoundSize, toSlot), out var to)) return;

        if (isHome)
            to.HomeCode = codeToAdvance;
        else
            to.AwayCode = codeToAdvance;
    }

    /// <summary>
    /// Generates a unique HTML element identifier for a given fixture.
    /// </summary>
    private string GetFixtureId(FixtureModel f)
        => $"match-{f.BracketSlotViewModel}";

    /// <summary>
    /// Calculates the identifier of the next chronological fixture for the winner of this fixture.
    /// </summary>
    private string? GetNextFixtureId(FixtureModel f)
    {
        var slot = f.BracketSlotViewModel.ParseSlot();

        int nextRoundSize = slot.RoundSize / 2;
        if (nextRoundSize < 2) return null;

        var nextSlot = (int)Math.Ceiling(slot.SlotIndex / 2.0);
        return $"match-r{nextRoundSize}s{nextSlot}";
    }
}
