@* // Ignore Spelling: center centering mx *@

@page "/bracket/{TournamentCode}"

@using FamilySweepstake.Components
@using FamilySweepstake.Models
@using FamilySweepstake.Services
@using static FamilySweepstake.Models.Constants

@inject CacheService CacheSvc

<MudText Typo="Typo.h4" Class="mb-4">Playoff Bracket</MudText>

<MudHidden Breakpoint="Breakpoint.Xs" Invert>Xs-iPhone </MudHidden>
<MudHidden Breakpoint="Breakpoint.Sm" Invert>Sm-iPhone portrait,iPad</MudHidden>
<MudHidden Breakpoint="Breakpoint.Md" Invert>Md-iPad portrait</MudHidden>
<MudHidden Breakpoint="Breakpoint.Lg" Invert>Lg-Desktop</MudHidden>
<MudHidden Breakpoint="Breakpoint.Xl" Invert>Xl-Desktop</MudHidden>

@if (_isLoading)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="mt-16">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.body1" Class="mt-2 text-muted">Loading bracket...</MudText>
    </MudStack>
}
else
{
    <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
        @for (int i = 0; i < _groupedRounds.Count; i++)
        {
            var roundIdx = i; // Need `roundIdx` as `i` is maxed out after rendering
            <MudButton OnClick="@(() => OnRoundSelected(roundIdx))" Disabled="@(roundIdx == _activeRound)" Class="mx-1">
                @RoundLabel(roundIdx)
            </MudButton>
        }
    </MudButtonGroup>

    <div class="bracket-container">
        @for (int i = 0; i < _groupedRounds.Count; i++)
        {
            var roundIdx = i;
            var group = _groupedRounds[i];
            var roundSize = group.Key;

            if (roundIdx < _activeRound)
                continue;

            <div class="bracket-round @(roundSize == 2 ? "medal-round" : "")">
                @if (roundSize == 2)
                {
                    // Medal Round: Center the Gold match and hang the Bronze match below it.
                    var goldMatch = group.FirstOrDefault(m => Decode(m.BracketSlot!).Slot == 2);
                    var bronzeMatch = group.FirstOrDefault(m => Decode(m.BracketSlot!).Slot == 1);

                    <div class="bracket-match-wrapper gold-match">
                        <div style="position: relative; width: 100%;">

                            @if (goldMatch is not null)
                            {
                                <MudPaper Elevation="3" Class="pa-3" Style="width: 100%;" id="@GetFixtureId(goldMatch)">
                                    <div class="d-flex justify-center mb-2">
                                        <MudText Typo="Typo.caption"><b>🏆 CHAMPIONSHIP</b></MudText>
                                    </div>
                                    <MudDivider Class="mb-2" />
                                    <div class="d-flex justify-space-between">
                                        <BracketNode Fixture="goldMatch" MedalIcons="GoldMedalIcons" />
                                    </div>
                                </MudPaper>
                            }

                            @if (bronzeMatch is not null)
                            {
                                <!-- Position absolute takes the bronze match out of the flow so it doesn't affect centering -->
                                <div style="position: absolute; top: calc(100% + 24px); width: 100%;" id="@GetFixtureId(bronzeMatch)">
                                    <MudPaper Elevation="3" Class="pa-3" Style="width: 100%;">
                                        <div class="d-flex justify-center mb-2">
                                            <MudText Typo="Typo.caption"><b>🥉 3RD PLACE PLAYOFF</b></MudText>
                                        </div>
                                        <MudDivider Class="mb-2" />
                                        <div class="d-flex justify-space-between">
                                            <BracketNode Fixture="bronzeMatch" MedalIcons="BronzeMedalIcons" />
                                        </div>
                                    </MudPaper>
                                </div>
                            }

                        </div>
                    </div>
                }
                else
                {
                    // Standard Match Output
                    @foreach (var match in group)
                    {
                        <div class="bracket-match-wrapper" id="@GetFixtureId(match)">
                            <MudPaper Elevation="3" Class="pa-3" Style="width: 100%;">
                                <div class="d-flex justify-space-between">
                                    <BracketNode Fixture="match" />
                                </div>
                            </MudPaper>
                        </div>
                    }
                }
            </div>
        }
    </div>
}

<style>
    .bracket-container {
        display: flex;
        flex-direction: row;
        overflow-x: auto;
        padding: 24px;
        gap: 40px;
        align-items: stretch; /* Ensures all rounds share the exact same height */
    }

    .bracket-round {
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        flex: 0 0 auto; /* Prevents resizing inside the flex container */
        /* Mobile default (xs) */
        width: 85vw;
    }

        .bracket-round.medal-round {
            width: 95vw;
        }

    /* sm breakpoint (Tablet) - MudBlazor uses 600px */
    @@media (min-width: 600px) {
        .bracket-round {
            width: 47vw;
        }

            .bracket-round.medal-round {
                width: 55vw;
            }
    }

    /* md breakpoint (Small Desktop) - MudBlazor uses 960px */
    @@media (min-width: 960px) {
        .bracket-round {
            width: 30vw;
        }

            .bracket-round.medal-round {
                width: 38vw;
            }
    }

    /* lg breakpoint (Desktop) - MudBlazor uses 1280px */
    @@media (min-width: 1280px) {
        .bracket-round {
            width: 25vw;
        }

            .bracket-round.medal-round {
                width: 30vw;
            }
    }

    .bracket-match-wrapper {
        position: relative;
        flex: 1; /* Makes wrappers stretch to touch each other for continuous vertical lines */
        display: flex;
        align-items: center;
        padding: 8px 0;
    }

    /* Draw the connecting lines */
    /* This is a comment */
    .bracket-round:not(:last-child) .bracket-match-wrapper:nth-child(odd)::after {
        content: "";
        position: absolute;
        right: -20px;
        top: 50%;
        width: 20px;
        height: 50%;
        border-top: 2px solid var(--mud-palette-lines-default);
        border-right: 2px solid var(--mud-palette-lines-default);
        border-top-right-radius: 4px;
    }

    .bracket-round:not(:last-child) .bracket-match-wrapper:nth-child(even)::after {
        content: "";
        position: absolute;
        right: -20px;
        bottom: 50%;
        width: 20px;
        height: 50%;
        border-bottom: 2px solid var(--mud-palette-lines-default);
        border-right: 2px solid var(--mud-palette-lines-default);
        border-bottom-right-radius: 4px;
    }

    /* Connect the converging elbows to the next match */
    .bracket-round:not(:first-child) .bracket-match-wrapper::before {
        content: "";
        position: absolute;
        left: -20px;
        top: 50%;
        width: 20px;
        border-top: 2px solid var(--mud-palette-lines-default);
    }
</style>

@code {
    [Parameter] public string TournamentCode { get; set; } = DEFAULT_CODE;

    private bool _isLoading = true;
    // private bool _animate = false;
    private int _activeRound = 0;

    private List<FixtureModel> _fixtures = [];

    // Structures flat fixtures into an ordered hierarchy for rendering
    private List<IGrouping<int, FixtureModel>> _groupedRounds = [];
    private List<IGrouping<int, FixtureModel>> _visibleRounds = [];
    private List<string> _medalIcons = [];
    private List<string> GoldMedalIcons => [.. _medalIcons.Take(2)];
    private List<string> BronzeMedalIcons => [.. _medalIcons.Skip(2).Take(2)];

    override protected void OnInitialized()
    {
        base.OnInitialized();

        _medalIcons = RANKING_ICONS.Split(',').ToList();
        while (_medalIcons.Count() < 4)
            _medalIcons.Add(CONFUSED_EMOJI);
    }

    /// <summary>
    /// Initialises the component parameters and loads the bracket data.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        await CacheSvc.SetTournamentAsync(TournamentCode);
        await BuildBracketAsync();
        _isLoading = false;
    }

    /// <summary>
    /// Builds the tournament bracket by fetching fixtures, advancing winners, and grouping rounds.
    /// </summary>
    private async Task BuildBracketAsync()
    {
        _fixtures = await CacheSvc.Service.GetBracketFixturesAsync(TournamentCode);

        BuildBracketDetail();

        _groupedRounds = _fixtures
            .OrderBy(f => Decode(f.BracketSlot!).Slot) // Sort by slot (1, 2, 3...) first
            .GroupBy(f => Decode(f.BracketSlot!).RoundSize)
            .OrderByDescending(g => g.Key)
            .ToList();

        UpdateVisibleRounds();

        // _animate = true;
    }

    /// <summary>
    /// Updates the currently active round and handles animation state changes.
    /// </summary>
    /// <param name="roundIdx">The index of the round to make active.</param>
    private void OnRoundSelected(int roundIdx)
    {
        _activeRound = roundIdx;
        // _animate = false;
        UpdateVisibleRounds();
        // _animate = true;
    }

    /// <summary>
    /// Updates the collection of visible rounds by skipping prior rounds.
    /// </summary>
    private void UpdateVisibleRounds()
        => _visibleRounds = _groupedRounds.Skip(_activeRound).ToList();

    /// <summary>
    /// Builds the internal fixture details by simulating the advancement of winners and losers.
    /// </summary>
    private void BuildBracketDetail()
    {
        var bySlot = _fixtures.ToDictionary(f => Decode(f.BracketSlot!), f => f);

        // Example mappings: Round of 8 to Semifinals, Semifinals to Finals
        AdvanceWinner(bySlot, 8, 1, 4, 1, true);
        AdvanceWinner(bySlot, 8, 2, 4, 1, false);

        AdvanceWinner(bySlot, 8, 3, 4, 2, true);
        AdvanceWinner(bySlot, 8, 4, 4, 2, false);

        AdvanceLoser(bySlot, 4, 1, 2, 1, true);
        AdvanceLoser(bySlot, 4, 2, 2, 1, false);

        AdvanceWinner(bySlot, 4, 1, 2, 2, true);
        AdvanceWinner(bySlot, 4, 2, 2, 2, false);
    }

    /// <summary>
    /// Advances the winner of a given fixture to the designated slot in a future round.
    /// </summary>
    private void AdvanceWinner(Dictionary<BracketSlot, FixtureModel> fixtures, int fromRoundSize, int fromSlot, int toRoundSize, int toSlot, bool isHome)
    {
        var fromKey = new BracketSlot(fromRoundSize, fromSlot);
        if (!fixtures.TryGetValue(fromKey, out var from)) return;

        var winnerCode = from.HomeWin ? from.HomeCode : from.AwayCode;

        var toKey = new BracketSlot(toRoundSize, toSlot);
        if (!fixtures.TryGetValue(toKey, out var to)) return;

        if (isHome)
            to.HomeCode = winnerCode;
        else
            to.AwayCode = winnerCode;
    }

    /// <summary>
    /// Advances the loser of a given fixture to the designated slot in a future round.
    /// </summary>
    private void AdvanceLoser(Dictionary<BracketSlot, FixtureModel> fixtures, int fromRoundSize, int fromSlot, int toRoundSize, int toSlot, bool isHome)
    {
        var fromKey = new BracketSlot(fromRoundSize, fromSlot);
        if (!fixtures.TryGetValue(fromKey, out var from)) return;

        var loserCode = from.HomeWin ? from.AwayCode : from.HomeCode;

        var toKey = new BracketSlot(toRoundSize, toSlot);
        if (!fixtures.TryGetValue(toKey, out var to)) return;

        if (isHome)
            to.HomeCode = loserCode;
        else
            to.AwayCode = loserCode;
    }

    /// <summary>
    /// Decodes a string-based bracket slot into a structured object.
    /// </summary>
    private static BracketSlot Decode(string slot)
    {
        var sIndex = slot.IndexOf('s');
        var r = int.Parse(slot[1..sIndex]);
        var s = int.Parse(slot[(sIndex + 1)..]);

        return new BracketSlot(r, s);
    }

    /// <summary>
    /// Gets the human-readable label for a specific tournament round.
    /// </summary>
    private string RoundLabel(int round) => round switch
    {
        0 => "Round of 32",
        1 => "Round of 16",
        2 => "Quarterfinals",
        3 => "Semifinals",
        4 => "Finals",
        _ => $"Round {round}"
    };

    /// <summary>
    /// Generates a unique HTML element identifier for a given fixture.
    /// </summary>
    private string GetFixtureId(FixtureModel f)
        => $"match-{f.BracketSlot}";

    /// <summary>
    /// Calculates the identifier of the next chronological fixture for the winner of this fixture.
    /// </summary>
    private string? GetNextFixtureId(FixtureModel f)
    {
        var slot = Decode(f.BracketSlot!);

        int nextRoundSize = slot.RoundSize / 2;
        if (nextRoundSize < 2) return null;

        var nextSlot = (int)Math.Ceiling(slot.Slot / 2.0);
        return $"match-r{nextRoundSize}s{nextSlot}";
    }

    private record BracketSlot(int RoundSize, int Slot);
}
