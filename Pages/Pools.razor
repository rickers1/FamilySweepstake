@page "/pools/{TournamentCode}"

@using FamilySweepstake.Components
@using FamilySweepstake.Models
@using FamilySweepstake.Services
@using FamilySweepstake.ViewModels

@using static FamilySweepstake.Models.Constants

@inject CacheService CacheSvc

<PageHeader ColouredIcon="@POOLS_COLOURED_ICON" Text="Pool Standings" />

@if (_isLoading)
{
    <LoadingSpinner WhatsIsLoading="pools" />
}
else
{
    <MudGrid Spacing="5" Justify="Justify.Center">
        @foreach (var poolGroup in _teamsByPool)
        {
            <MudItem xs="12" md="6" lg="4">
                <PoolCard Pool="poolGroup" />
            </MudItem>
        }
    </MudGrid>
}

@code {
    [Parameter] public string TournamentCode { get; set; } = string.Empty;

    private bool _isLoading = true;
    private bool _isFIFA;
    private IEnumerable<PoolGroupViewModel> _teamsByPool = [];

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        // Select tournament (this reloads TeamsCache automatically if needed)
        await CacheSvc.SetTournamentAsync(TournamentCode);

        _teamsByPool = await LoadPoolStandingsAsync();

        _isLoading = false;
    }

    private async Task<IEnumerable<PoolGroupViewModel>> LoadPoolStandingsAsync()
    {
        if (CacheSvc.Tournaments.GetCurrent() is not TournamentModel tournament)
        {
            _isLoading = false;
            return [];
        }

        _isFIFA = tournament.TournamentType == Models.TournamentType.Soccer;

        // Now get pool standings from the service
        var poolTeams = await CacheSvc.Service.GetPoolStandingsAsync(tournament.Id);

        return poolTeams
            .GroupBy(t => t.PoolName)
            .OrderBy(g => g.Key)
            .Select(g =>
                new PoolGroupViewModel(
                    g.Key,
                    g//.OrderByDescending(t => t.PoolRanking)
                )
            );
    }
}
