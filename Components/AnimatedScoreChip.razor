@using Microsoft.AspNetCore.Components;
@using MudBlazor

<MudStack Row AlignItems="AlignItems.Baseline" Justify="Justify.FlexStart">
    <MudChip T="string" Size="_scoreSize" Color="_scoreColour" Variant="Variant.Filled" Class="@_chipClass">
        @Score
    </MudChip>

    @if (ScorePens is not null)
    {
        <MudChip T="string" Size="Size.Small" Color="_scoreColour" Variant="Variant.Filled" Class="@_chipClass">
            @ScorePens
        </MudChip>
    }
</MudStack>

    @code {
    [Parameter, EditorRequired] public string TeamCode { get; set; } = default!;
    [Parameter, EditorRequired] public int? Score { get; set; }
    [Parameter] public int? ScorePens { get; set; }    // Penalties
    [Parameter] public bool Winner { get; set; }

    private static readonly Dictionary<string, int?> _previousScores = new();

    private const string BASE_CLASS = "points-chip";
    private const string ANIMATED_CLASS = BASE_CLASS + " updated";
    private const string WINNER_CLASS = "match_winner";
    private const string DRAWN_CLASS = "match_drawn";
    private const string LOSER_CLASS = "match_loser";

    private Size _scoreSize = Size.Medium;
    private Color _scoreColour = Color.Info;

    private string _chipClass = BASE_CLASS;

    protected override void OnParametersSet()
    {
        // Normalise nulls
        var newScore = Score + (ScorePens ?? 0);
        /*
        if (_previousScores.TryGetValue(TeamCode, out var oldScore))
            // Animate only when the score actually changes
            _chipClass = (oldScore != newScore) ? ANIMATED_CLASS : BASE_CLASS;
        else
            // First time seeing this team → no animation
            _chipClass = BASE_CLASS;
        */
        // Update stored score
        _previousScores[TeamCode] = newScore;

        if (Winner)
        {
            _scoreSize = Size.Large;
            _scoreColour = Color.Success;
        }
    }
}
