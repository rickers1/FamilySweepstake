@using Microsoft.AspNetCore.Components;
@using MudBlazor

<MudStack Row Spacing="0" AlignItems="AlignItems.Baseline" Justify="_scoreJustify">
    <MudBadge Visible="ScorePens is not null" Overlap Content="ScorePens" Color="Color.Primary">
        <MudChip T="string" Size="Size.Large" Color="_scoreColour" Variant="Variant.Filled">
            @Score
        </MudChip>
    </MudBadge>
</MudStack>

@code {
        [Parameter, EditorRequired] public string TeamCode { get; set; } = default!;
        [Parameter, EditorRequired] public int? Score { get; set; }
        [Parameter] public int? ScorePens { get; set; }    // Penalties
        [Parameter] public bool? Winner { get; set; }
        [Parameter] public bool Draw { get; set; }
        [Parameter] public bool RightAlign { get; set; }

    private Color _scoreColour = Color.Info;
    private Justify _scoreJustify = Justify.FlexStart;

    protected override void OnParametersSet()
    {
        _scoreJustify = RightAlign ? Justify.FlexEnd : Justify.FlexStart;
        if (Winner is true)
            _scoreColour = Color.Success;
        else if (Draw)
            _scoreColour = Color.Warning;
        else if (Winner is false)
            _scoreColour = Color.Error;
    }
}
