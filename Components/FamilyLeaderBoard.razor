@* // Ignore Spelling: color *@


<table class="table">
    <tbody>
        @foreach (var row in State.LeaderBoard)
        {
            <tr>
                <td>#@row.FamilyRank</td>
                <td>
                    <span class="badge" style="background-color: @row.Member.BackgroundColor; color: @row.Member.ForegroundColor">
                        @row.Member.Name
                    </span>
                </td>
                <td>@row.TotalPoolPoints pts</td>
            </tr>
        }
    </tbody>
</table>

