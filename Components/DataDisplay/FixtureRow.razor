@* // Ignore Spelling: center py tt *@

@using FamilySweepstake.Extensions
@using FamilySweepstake.Models
@using FamilySweepstake.Services
@using static FamilySweepstake.Models.Constants

@inject CacheService CacheSvc

<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged">
    <MudGrid Spacing="0" Class="align-center text-center">

        <MudItem xs="12" sm="12" md="1">
            <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert>
                <MudText Typo="Typo.caption">@_matchStart</MudText>
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.SmAndUp">
                <MudText Typo="Typo.body2">@_matchStart</MudText>
            </MudHidden>
        </MudItem>

        <MudItem xs="10" sm="5" md="4">
            <TeamCard TeamCode="@Fixture.HomeCode" ShowOwner OwnerId="_homeTeamOwnerId" />
        </MudItem>

        <MudItem xs="2" sm="1" md="1">
            <ScoreChip TeamCode="@Fixture.HomeCode" Score="Fixture.HomeScore" ScorePens="Fixture.HomePens" Winner="Fixture.HomeWin" Draw="@_isDraw" />
        </MudItem>

        <MudItem xs="10" sm="5" md="4" Class="@_awayTeamOrderCss">
            <TeamCard TeamCode="@Fixture.AwayCode" ShowOwner OwnerId="_awayTeamOwnerId" />
        </MudItem>

        <MudItem xs="2" sm="1" md="1" Class="@_awayScoreOrderCss">
            <ScoreChip TeamCode="@Fixture.AwayCode" Score="Fixture.AwayScore" ScorePens="Fixture.AwayPens" Winner="Fixture.AwayWin" Draw="@_isDraw" AlignRight="_wideLayout" />
        </MudItem>

    </MudGrid>
</MudBreakpointProvider>

@code {
    [Parameter, EditorRequired] public FixtureModel Fixture { get; set; }
    [Parameter] public bool ShowMatchDateAndTime { get; set; }

    private Guid? _homeTeamOwnerId;
    private Guid? _awayTeamOwnerId;
    private string _matchStart = string.Empty;
    private string _awayTeamOrderCss = string.Empty;
    private string _awayScoreOrderCss = string.Empty;
    private bool _wideLayout = true;
    private bool _isDraw;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        _matchStart = Fixture.MatchStart.ToString(ShowMatchDateAndTime ? MATCH_DATE_TIME_FORMAT : MATCH_TIME_FORMAT);

        _homeTeamOwnerId = CacheSvc.TeamOwners.GetOwnerIdByCode(Fixture.HomeCode, Fixture.IsPlayoffs);
        _awayTeamOwnerId = CacheSvc.TeamOwners.GetOwnerIdByCode(Fixture.AwayCode, Fixture.IsPlayoffs);
        _isDraw = Fixture.HomeWin == Fixture.AwayWin;
    }

    private void OnBreakpointChanged(Breakpoint bp)
    {
        _wideLayout = (bp >= Breakpoint.Sm);

        _awayScoreOrderCss = _wideLayout.GetOrderClass(1, 2);
        _awayTeamOrderCss = _wideLayout.GetOrderClass(2, 1);

        Console.WriteLine($"Breakpoint changed to {bp}. Wide layout: {_wideLayout}. Score order CSS: {_awayScoreOrderCss}, Team order CSS: {_awayTeamOrderCss}");
    }
}
