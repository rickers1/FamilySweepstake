@using FamilySweepstake.Models
@using FamilySweepstake.Services
@using FamilySweepstake.ViewModels

@inject CacheService CacheSvc

<MudGrid Spacing="0" Class="align-center text-center">
    <MudItem xs="10" sm="8" md="9">
    </MudItem>

    <MudHidden Breakpoint="Breakpoint.Xs">
        @if (ShowWDL)
        {
            <MudItem xs="0" sm="2" md="1">
                W-D-L
            </MudItem>
            <MudItem xs="0" sm="1" md="1">
                <MudText Typo="Typo.body2">
                    @_otherHeader
                </MudText>
            </MudItem>
        }
    </MudHidden>

    @if (ShowPoints)
    {
        <MudItem xs="2" sm="1" md="1">
            Points
        </MudItem>
    }
</MudGrid>

@foreach (var team in Teams)
{
    <MudGrid Spacing="0" Class="align-center text-center">
        <MudItem xs="10" sm="8" md="9">
            <TeamCard TeamCode="@team.TeamCode" ShowOwner="ShowOwner" OwnerId="GetTeamOwner(team)" />
        </MudItem>

        <MudHidden Breakpoint="Breakpoint.Xs">
            @if (ShowWDL)
            {
                <MudItem xs="0" sm="2" md="1">
                    <MudText Typo="Typo.body2">@team.Wins‑@team.Draws‑@team.Losses</MudText>
                </MudItem>
                <MudItem xs="0" sm="1" md="1">
                    <MudText Typo="Typo.body2">
                        @if (_tournamentIsSoccer)
                        {
                            @team.FifaPointDeductions
                        }
                        else
                        {
                            @team.RwcBonusPoints
                        }
                    </MudText>
                </MudItem>
            }
        </MudHidden>

        @if (ShowPoints)
        {
            <MudItem xs="2" sm="1" md="1">
                <ScoreChip Score="@team.Points" TeamCode="@team.TeamCode" />
            </MudItem>
        }
    </MudGrid>
}

@code {
    [Parameter, EditorRequired] public IEnumerable<PoolStandingModel> Teams { get; set; } = [];
    [Parameter] public bool ShowOwner { get; set; } = true;
    [Parameter] public bool ShowWDL { get; set; } = false;
    [Parameter] public bool ShowPoints { get; set; } = true;

    private const string SOCCER_OTHER_HEADER = "Deduct";
    private const string RUGBY_OTHER_HEADER = "Bonus";
    private List<PoolStandingViewModel> _teamsWithOwners = [];
    private readonly Dictionary<string, int> _previousPoints = new();
    private bool _tournamentIsSoccer;
    private string _otherHeader = SOCCER_OTHER_HEADER;

    protected override void OnParametersSet()
    {
        _tournamentIsSoccer = (CacheSvc.Tournaments.GetCurrent()!.TournamentType is TournamentType.Soccer);
        _otherHeader = _tournamentIsSoccer ? SOCCER_OTHER_HEADER : RUGBY_OTHER_HEADER;
    }

    private bool IsAutoQualifier(PoolStandingModel team)
    {
        var tournament = CacheSvc.Tournaments.GetCurrent();
        if (tournament is null || tournament.NumberOfPlayoffAutoQualifiers <= 0)
            return false;

        return Teams
            .Take(tournament.NumberOfPlayoffAutoQualifiers)
            .Contains(team);
    }

    private Guid? GetTeamOwner(PoolStandingModel team)
        => CacheSvc.TeamOwners.GetOwnerIdByCode(team.TeamCode);
}
